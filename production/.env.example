# Production environment — copy to `.env` inside this directory.
# Run: cd production && docker compose up -d --build
APP_ENV=production

POSTGRES_DB=fake_news_db
POSTGRES_USER=username
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://username:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fake_news_db
QDRANT_HOST=qdrant
QDRANT_PORT=6333
SIMILARITY_THRESHOLD=0.92
CRED1_PATH=/data/cred1_compact.json

# Extension build target (used by Vite's production build)
VITE_API_BASE=https://verifact.duckdns.org
# Google OAuth "Web application" client id — must match GOOGLE_CLIENT_ID below.
# Redirect URI in Google Cloud: https://<your-extension-id>.chromiumapp.org/
VITE_GOOGLE_CLIENT_ID=

# Google AI Studio — https://aistudio.google.com/apikey
OPENROUTER_API_KEY=

# Serper.dev — https://serper.dev (2,500 free queries)
SERPER_API_KEY=

# Authentication (Google Sign-In via chrome.identity launchWebAuthFlow + PKCE)
# Google OAuth "Web application" client id — must match VITE_GOOGLE_CLIENT_ID above.
GOOGLE_CLIENT_ID=
# Google OAuth "Web application" client secret (used server-side for the token exchange)
GOOGLE_CLIENT_SECRET=
# Secret used to sign the session JWT (generate with: openssl rand -hex 32)
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
# How long a refresh token stays valid before full re-login is required
REFRESH_TOKEN_EXPIRE_DAYS=30

# Daily quota: number of analysis checks allowed per account per day (UTC)
DAILY_CHECK_LIMIT=5

# Burst protection (per rolling window). These limits complement, rather than
# replace, the daily quota above.
RATE_LIMIT_WINDOW_SECONDS=60
ANALYZE_RATE_LIMIT_PER_MINUTE=3
ANALYZE_IP_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_MINUTE=10
PUBLIC_RATE_LIMIT_PER_MINUTE=30
