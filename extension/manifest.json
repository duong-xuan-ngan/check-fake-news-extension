{
  "manifest_version": 3,
  "name": "VeriFact",
  "version": "0.1.0",
  "description": "Highlight text on any webpage to check for fake news using AI analysis.",
  "permissions": [
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://verifact.duckdns.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*", "content.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_title": "VeriFact"
  }
}
